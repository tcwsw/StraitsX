# The execution-agent / dashboard process's OWN dotenv file — loaded via
# config/process_env.isolate_execution_agent_env() in agent/run.py and dashboard/app.py.
# Only the allow-listed keys below are ever read from this file; the process REFUSES TO
# START if AGENT_PRIVATE_KEY, POLICY_SECRET, or RELAYER_PRIVATE_KEY is present here or
# already exported in the shell. Those belong exclusively to .env.policy.
#
# Copy to .env.app (gitignored) and fill in real values. Never commit the filled-in file.

# scripted (default) = deterministic choose() in agent/run.py, no LLM call.
# openai = agent/execution_agent.py via the OpenAI Agents SDK.
AGENT_MODE=scripted
# scripted (default) = deterministic evaluate_scripted() in audit/audit_agent.py, no LLM
# call. openai = audit/audit_agent.py's own, independent Agent/Runner round trip.
AUDIT_MODE=scripted
# Required only when AGENT_MODE=openai or AUDIT_MODE=openai. Both agents refuse to start
# without it.
OPENAI_API_KEY=
# Model name passed to agents.Agent(model=...). Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini
POLICY_URL=http://127.0.0.1:4020
MERCHANTS_URL=http://127.0.0.1:4030
