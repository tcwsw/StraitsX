# pg/policy_server.py's OWN, private dotenv file — loaded by _load_policy_dotenv() in
# pg/policy_server.py, and by ./run.sh, before anything else. NEVER shared with the
# execution-agent/dashboard process (see .env.app.example for that side).
#
# Copy to .env.policy (gitignored) and fill in real values. Never commit the filled-in file.

# Agent wallet (generate a throwaway: python -c "from eth_account import Account; a=Account.create(); print(a.key.hex(), a.address)")
AGENT_PRIVATE_KEY=
# Policy engine HMAC secret. REQUIRED — the process refuses to start without one.
# Generate a real value, at least 32 chars:
#   python -c "import secrets; print(secrets.token_hex(32))"
POLICY_SECRET=
# eip155:43113 = Avalanche Fuji, eip155:43114 = mainnet
X402_NETWORK=eip155:43113
ALLOWED_NETWORKS=eip155:43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# verify | onchain   (onchain needs a gas-funded relayer)
SETTLE_MODE=verify
RELAYER_PRIVATE_KEY=
WALLET_TECHSTORE=
WALLET_GADGETHUB=
WALLET_QUICK=
WALLET_BARGAIN=

# Public address AGENT_PRIVATE_KEY derives to. Used only by read-only tooling
# (tools/check_wallet_match.py, tools/live_self_transfer.py) to sanity-check the demo's
# self-transfer wiring — never used to sign anything on its own.
WHITELISTED_WALLET_ADDRESS=

# Self-transfer demonstration (payer address == merchant payment_recipient) is refused by
# pg/policy_server.py's /authorize unless this is explicitly true. Defaults closed. Never
# commit this as true.
ALLOW_SELF_TRANSFER_DEMO=false

# data/merchant_registry.json ships with every payment_recipient left null/*_TODO_REQUIRED
# on purpose (see config/loader.py's ownership-boundary convention) — never edit that
# committed file to add a real wallet. To complete it locally (required for
# `./run.sh live-self-transfer`, where techstore's payment_recipient must equal the address
# derived from AGENT_PRIVATE_KEY), copy data/merchant_registry.local.json.example to
# data/merchant_registry.local.json (gitignored), fill in the real address, and point this
# at it:
MERCHANT_REGISTRY_PATH=data/merchant_registry.local.json
