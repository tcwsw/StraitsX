# Agent wallet (generate a throwaway: python -c "from eth_account import Account; a=Account.create(); print(a.key.hex(), a.address)")
AGENT_PRIVATE_KEY=
# Policy engine HMAC secret. The execution agent must NOT have this. REQUIRED — the process
# refuses to start without one. Generate a real value, at least 32 chars:
#   python -c "import secrets; print(secrets.token_hex(32))"
POLICY_SECRET=
# eip155:43113 = Avalanche Fuji, eip155:43114 = mainnet
X402_NETWORK=eip155:43113
ALLOWED_NETWORKS=eip155:43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# verify | onchain   (onchain needs a gas-funded relayer)
SETTLE_MODE=verify
RELAYER_PRIVATE_KEY=
WALLET_TECHSTORE=
WALLET_GADGETHUB=
WALLET_QUICK=
WALLET_BARGAIN=
# scripted (default) = deterministic choose() in agent/run.py, no LLM call.
# openai = agent/execution_agent.py via the OpenAI Agents SDK.
AGENT_MODE=scripted
# scripted (default) = deterministic evaluate_scripted() in audit/audit_agent.py, no LLM
# call. openai = audit/audit_agent.py's own, independent Agent/Runner round trip — a
# completely separate agent from AGENT_MODE=openai above, sharing no session or prompt.
AUDIT_MODE=scripted
# Required only when AGENT_MODE=openai or AUDIT_MODE=openai. Both agents refuse to start
# without it.
OPENAI_API_KEY=
# Model name passed to agents.Agent(model=...). Defaults to gpt-4o-mini if unset. Used by
# both the execution agent and the audit agent.
OPENAI_MODEL=gpt-4o-mini
